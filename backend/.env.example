# Copy to .env and fill in. .env is read automatically by `npm start` (Node 21+).
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=vote-min

# Generate with: openssl rand -hex 32
# Keep this the same across restarts, or every organiser's manage-page login breaks.
VOTE_MIN_SECRET=

PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=*
