# Copy to .env.local and fill in. Next.js loads .env.local automatically — no flag needed.
# .env.local is git-ignored by default; don't commit it.

# Where the backend API lives. Used by next.config.js to proxy /api/* to it.
# Leave unset for local dev (defaults to http://127.0.0.1:4000).
API=http://127.0.0.1:4000
